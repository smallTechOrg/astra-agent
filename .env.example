# === LLM ===
# Provider: "openai", "anthropic", or "groq"
ASTRA_LLM__PROVIDER=openai
ASTRA_LLM__API_KEY=sk-...
ASTRA_LLM__MODEL=gpt-4o
# For Groq: set provider=groq, model=llama-3.3-70b-versatile (or any Groq model)
# ASTRA_LLM__PROVIDER=groq
# ASTRA_LLM__API_KEY=gsk_...
# ASTRA_LLM__MODEL=llama-3.3-70b-versatile

# === WordPress ===
ASTRA_WORDPRESS__URL=https://yourblog.com
ASTRA_WORDPRESS__USERNAME=admin
# WordPress app passwords contain spaces — always quote them
ASTRA_WORDPRESS__APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# === Twitter ===
ASTRA_TWITTER__API_KEY=
ASTRA_TWITTER__API_SECRET=
ASTRA_TWITTER__ACCESS_TOKEN=
ASTRA_TWITTER__ACCESS_SECRET=
ASTRA_TWITTER__BEARER_TOKEN=

# === LinkedIn ===
# Get an access token by running: astra auth linkedin --client-id <ID> --client-secret <SECRET>
# Prerequisite: add http://localhost:8989/callback as a redirect URL in your LinkedIn app
# and request the "Share on LinkedIn" product in the LinkedIn developer portal.
ASTRA_LINKEDIN__ACCESS_TOKEN=

# Set to post as a company page instead of your personal profile.
# Find the numeric ID in your company admin panel or the organizationUrn in page source.
ASTRA_LINKEDIN__ORGANIZATION_ID=

# LinkedIn OAuth2 app credentials (only needed to run `astra auth linkedin`)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
